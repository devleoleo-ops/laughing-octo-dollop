# =============================================
#  Backend API — Environment Variables
#  Set semua ini di Vercel Dashboard:
#  Project → Settings → Environment Variables
# =============================================

# ── Security secrets (WAJIB) ──────────────────────────────────
# Generate baru dengan: node -e "require('crypto').randomBytes(48).toString('base64url')|>console.log"

CSRF_SECRET=348QHGORE6pIFgOkXPo85XJeJYctUlA4m5c6ULigT2TdA-7RPRwh5GlJQFBzX_-c
IP_SALT=0782fe1f3c55fa6c17872e05defb6fa97a434e02ef9dad834222d24091107f9a

# ── Allowed origins (opsional, hardcoded sudah ada fallback) ──
ALLOWED_ORIGIN=https://naomi-rch.zone.id

# ── Daily & queue limits ──────────────────────────────────────
DAILY_LIMIT=3
MAX_QUEUE_SIZE=20

# ── Firebase (pilih salah satu cara) ─────────────────────────
# Cara 1: JSON lengkap (paste isi service account JSON, satu baris)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# Cara 2: Variable terpisah
FIREBASE_PROJECT_ID=rch-kazehaya
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@rch-kazehaya.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── VPS API (untuk server.js standalone, bukan Vercel) ───────
