  rules_version = '2';

  service cloud.firestore {
    match /databases/{database}/documents {

      // ─── cooldowns ────────────────────────────────────────────────────────────
      // Limit harian per fingerprint (UUID dari localStorage).
      match /cooldowns/{fp} {
        allow read, write: if true;
      }

      // ─── react_queue ─────────────────────────────────────────────────────────
      // Antrian reaction.
      // Frontend (browser) langsung menambahkan item baru dengan isDone: false.
      // Hanya VPS (Firebase Admin SDK) yang boleh mengubah status (isDone: true) atau delete.
      match /react_queue/{docId} {
        // Browser boleh menambahkan tugas baru jika isDone == false
        allow create: if request.resource.data.isDone == false
                      && request.resource.data.target is string
                      && request.resource.data.reaction is string;
        // Browser boleh membaca status tugas
        allow read: if true;
        // Update & Delete hanya lewat Admin SDK di VPS (rules ini dilewati Admin SDK)
        allow update, delete: if false;
      }

      // ─── Koleksi lain ────────────────────────────────────────────────────────
      match /{document=**} {
        allow read, write: if false;
      }
    }
  }
