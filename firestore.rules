rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── cooldowns ────────────────────────────────────────────────────────────
    // Limit harian per fingerprint (UUID dari localStorage).
    // WRITE hanya oleh server (Admin SDK bypass rules ini).
    // READ boleh dari browser — frontend perlu baca sisa limit milik sendiri.
    match /cooldowns/{fp} {

      // Browser boleh baca doc miliknya sendiri
      allow read: if true;

      // Browser TIDAK boleh tulis langsung —
      // penulisan dilakukan oleh Vercel (Admin SDK, bypass rules).
      // Kalau kamu mau tetap allow write dari FE lama, uncomment blok di bawah:
      //
      // allow write: if
      //   request.resource.data.keys().hasOnly(['count', 'dayStartAt', 'updatedAt'])
      //   && request.resource.data.count is int
      //   && request.resource.data.count >= 0
      //   && request.resource.data.count <= 3
      //   && (
      //        !resource.data.keys().hasAny(['count'])
      //        || request.resource.data.count <= resource.data.count + 1
      //        || request.resource.data.count == 0
      //      )
      //   && (
      //        request.resource.data.dayStartAt == null
      //        || request.resource.data.dayStartAt is timestamp
      //      )
      //   && request.resource.data.updatedAt == request.time;

      allow write:  if false; // hanya Admin SDK (server)
      allow delete: if false;
    }

    // ─── react_queue ─────────────────────────────────────────────────────────
    // Antrian reaction. Hanya ditulis oleh Vercel & dibaca/diupdate oleh VPS.
    // Browser TIDAK boleh baca atau tulis sama sekali.
    match /react_queue/{docId} {
      allow read, write: if false; // 100% server-only (Admin SDK)
    }

    // ─── ip_limits ────────────────────────────────────────────────────────────
    // Rate limit per IP hash. Hanya ditulis & dibaca oleh Vercel.
    // Browser tidak boleh akses.
    match /ip_limits/{ipHash} {
      allow read, write: if false; // server-only
    }

    // ─── Semua koleksi lain: DITOLAK ─────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
