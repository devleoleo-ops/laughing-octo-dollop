rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── cooldowns collection ──────────────────────────────────────────────────
    // Menyimpan jumlah penggunaan harian per fingerprint anonim.
    // Key     = fingerprint (UUID dari localStorage).
    // dayStartAt = Timestamp tengah malam (00:00:00) saat hari pertama pakai.
    // count   = jumlah pemakaian di hari tersebut (max 3).
    // Reset otomatis sisi klien ketika dayStartAt < midnight hari ini.
    match /cooldowns/{fp} {

      // Siapa saja boleh baca dokumen miliknya sendiri.
      allow read: if true;

      // Boleh create/update dengan validasi ketat:
      allow write: if
        // 1. Hanya field yang dikenal
        request.resource.data.keys().hasOnly(['count', 'dayStartAt', 'updatedAt'])

        // 2. count harus integer ≥ 0 dan ≤ 3 (FREE_LIMIT)
        && request.resource.data.count is int
        && request.resource.data.count >= 0
        && request.resource.data.count <= 3

        // 3. count tidak boleh naik lebih dari 1 per request
        //    (mencegah klien langsung set count besar)
        && (
             !resource.data.keys().hasAny(['count'])        // dokumen baru
             || request.resource.data.count <= resource.data.count + 1
             || request.resource.data.count == 0            // reset hari baru
           )

        // 4. dayStartAt harus berupa Timestamp (bukan null, kecuali reset)
        && (
             request.resource.data.dayStartAt == null
             || request.resource.data.dayStartAt is timestamp
           )

        // 5. updatedAt harus selalu pakai server timestamp
        && request.resource.data.updatedAt == request.time;

      // Tidak boleh dihapus dari klien
      allow delete: if false;
    }

    // Semua koleksi lain ditolak
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
